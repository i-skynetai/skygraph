; Go. A type is the container; a method's receiver type is recovered by the interpreter
; from the enclosing declaration when there is one.
(type_spec) @container
(function_declaration) @callable
(method_declaration) @callable
(call_expression) @call
(import_spec) @import
(field_declaration) @binding
(parameter_declaration) @binding
(var_spec) @binding
(short_var_declaration) @binding
